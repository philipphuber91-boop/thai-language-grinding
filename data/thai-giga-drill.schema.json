{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thai-language-grinding.example/schemas/thai-giga-drill.v1.json",
  "title": "Thai Giga Drill Content v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentVersion",
    "contentStatus",
    "language",
    "levels",
    "words",
    "archivedIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentStatus": {
      "enum": [
        "draft",
        "complete",
        "placeholder-only"
      ]
    },
    "language": {
      "const": "th"
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    },
    "archivedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contentStatus": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "levels": {
            "items": {
              "properties": {
                "bosses": {
                  "items": {
                    "properties": {
                      "blocks": {
                        "minItems": 5,
                        "maxItems": 5
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "level": {
      "type": "object",
      "required": [
        "id",
        "title",
        "bosses"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "bosses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boss"
          }
        }
      },
      "additionalProperties": true
    },
    "boss": {
      "type": "object",
      "required": [
        "id",
        "title",
        "grammarFocus",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "grammarFocus": {
          "type": "string",
          "minLength": 1
        },
        "introduction": {
          "$ref": "#/$defs/introduction"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/foundationBlock"
          }
        },
        "reminders": {
          "$ref": "#/$defs/supplementalContent"
        },
        "completion": {
          "$ref": "#/$defs/supplementalContent"
        }
      },
      "additionalProperties": true
    },
    "introduction": {
      "type": "object",
      "required": [
        "description",
        "example",
        "parts",
        "assembly",
        "warning"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "$ref": "#/$defs/introductionExample"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/introductionExample"
          }
        },
        "assembly": {
          "$ref": "#/$defs/introductionExample"
        },
        "warning": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "introductionExample": {
      "type": "object",
      "required": [
        "thai",
        "transliteration",
        "translation"
      ],
      "properties": {
        "thai": {
          "type": "string",
          "minLength": 1
        },
        "transliteration": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "foundationBlock": {
      "type": "object",
      "required": [
        "id",
        "title",
        "miniStories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "miniStories": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/miniStory"
          }
        },
        "reminder": {
          "$ref": "#/$defs/supplementalContent"
        },
        "completion": {
          "$ref": "#/$defs/supplementalContent"
        }
      },
      "additionalProperties": true
    },
    "miniStory": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sentences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "speakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speaker"
          }
        },
        "sentences": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/sentence"
          }
        }
      },
      "additionalProperties": true
    },
    "sentence": {
      "type": "object",
      "required": [
        "id",
        "thai",
        "transliteration",
        "translation",
        "tokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "thai": {
          "type": "string",
          "minLength": 1
        },
        "transliteration": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        },
        "speakerId": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "audio": {
          "$ref": "#/$defs/audio"
        }
      },
      "additionalProperties": true
    },
    "speaker": {
      "type": "object",
      "required": [
        "id",
        "role",
        "assignmentSource",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "characterId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "assignmentSource": {
          "enum": [
            "explicit",
            "contextual",
            "uncertain",
            "neutral"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "voiceProfileId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "token": {
      "type": "object",
      "required": [
        "id",
        "text",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "word",
            "punctuation",
            "space"
          ]
        },
        "wordId": {
          "type": "string",
          "minLength": 1
        },
        "contextMeaning": {
          "type": "string",
          "minLength": 1,
          "description": "Die in diesem Satz gemeinte Übersetzung oder grammatische Verwendung; besonders bei mehreren Bedeutungen, Pronomenformen und festen Wendungen."
        }
      },
      "additionalProperties": true
    },
    "word": {
      "type": "object",
      "required": [
        "id",
        "thai",
        "transliteration",
        "meanings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "thai": {
          "type": "string",
          "minLength": 1
        },
        "transliteration": {
          "type": "string",
          "minLength": 1
        },
        "meanings": {
          "type": "array",
          "minItems": 1,
          "description": "Alle relevanten Bedeutungen bzw. Lesarten des Wortes. Eine konkrete grammatische Form oder Verwendung kann am Token mit contextMeaning präzisiert werden.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "syllables": {
          "type": "array",
          "minItems": 2,
          "description": "Optionale Silbenstruktur für mehrsilbige Wörter; die Thai-Teile müssen zusammen exakt thai ergeben.",
          "items": {
            "$ref": "#/$defs/syllable"
          }
        }
      },
      "additionalProperties": true
    },
    "syllable": {
      "type": "object",
      "required": [
        "thai",
        "transliteration"
      ],
      "properties": {
        "thai": {
          "type": "string",
          "minLength": 1
        },
        "transliteration": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "speechSynthesis",
            "url",
            "none"
          ]
        },
        "src": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "url"
              }
            }
          },
          "then": {
            "required": [
              "src"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "supplementalContent": {
      "type": [
        "object",
        "array",
        "null"
      ]
    }
  }
}
